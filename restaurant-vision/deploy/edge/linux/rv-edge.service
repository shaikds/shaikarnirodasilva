# Restaurant Vision edge engine. Installed by deploy/edge/linux/install.sh as
# /etc/systemd/system/rv-edge.service. Local changes belong in a drop-in
# (systemctl edit rv-edge), not in this file, so a reinstall does not overwrite them.
[Unit]
Description=Restaurant Vision edge engine (anonymous on-site video analytics)
Documentation=https://github.com/shaikds/shaikarnirodasilva/tree/main/restaurant-vision/docs/runbooks/install-edge.md
Wants=network-online.target
After=network-online.target
# Give up after 10 failed starts in 10 minutes (a broken config should not spin forever).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=rv-edge
Group=rv-edge
Environment=RV_EDGE_CONFIG=/etc/rv-edge/edge.yaml
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rv-edge/venv/bin/rv-edge run --config /etc/rv-edge/edge.yaml
WorkingDirectory=/var/lib/rv-edge
Restart=on-failure
RestartSec=5
# SIGTERM stops the LAN API, then the runtime flushes and closes the outbox.
KillSignal=SIGTERM
TimeoutStopSec=30

# Be a polite guest on a shared PC: low CPU and I/O priority, smaller CPU share under load.
# (The engine also backs off frames above cpu_limit_pct in edge.yaml.)
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=50

# State: /var/lib/rv-edge (secrets, site config, outbox), owner-only.
StateDirectory=rv-edge
StateDirectoryMode=0700
UMask=0077

# Sandboxing. The service needs: outbound HTTPS (cloud), RTSP/ONVIF on the LAN, a listening
# socket on 8787, read access to /opt/rv-edge and /etc/rv-edge, write access to its state dir.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Intel iGPU inference (OpenVINO GPU) needs /dev/dri: add a drop-in with
#   PrivateDevices=no
#   SupplementaryGroups=render video
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute is left off: ctypes/libffi callbacks in the Python stack need W+X pages.

[Install]
WantedBy=multi-user.target
