# --- Database ---
DATABASE_URL="postgresql://groupbuy:groupbuy_dev_password@localhost:5432/groupbuy"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-real-secret"
AUTH_TRUST_HOST="true"
# Optional Google OAuth (leave empty to disable the Google button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- LLM provider ---
# "mock"   : deterministic built-in engine, no model needed (default; used in CI/evals)
# "openai-compat" : any OpenAI-compatible endpoint (Ollama, DeepSeek, etc.)
LLM_PROVIDER="mock"
# Ollama on your Mac: http://localhost:11434/v1  (private, recommended)
# DeepSeek: https://api.deepseek.com/v1  (data leaves your machine — less private)
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="gemma3:12b-it-qat"
LLM_API_KEY=""

# --- Agent guardrail limits ---
AGENT_MAX_ACTIONS_PER_CYCLE="20"
AGENT_MAX_OPEN_DEALS_PER_SUPPLIER="3"
AGENT_MIN_TRUST_SCORE="50"
AGENT_MIN_REAL_DISCOUNT_PCT="10"

# --- Trending scraper ---
# Leave FIRECRAWL_API_KEY empty to use the deterministic mock scraper (dev/CI).
# With a key, KSP is fetched via its public JSON API and Super-Pharm + Zap go
# through Firecrawl (both are bot-protected).
FIRECRAWL_API_KEY=""
# Secret for POST /api/cron/scrape (weekly scheduler). Empty = endpoint disabled.
CRON_SECRET=""
TRENDING_TOP_N="5"
TRENDING_CLAIM_WINDOW_HOURS="72"
TRENDING_UNCLAIMED_EXPIRY_DAYS="14"
TRENDING_ZERO_VOTE_EXPIRY_DAYS="7"
