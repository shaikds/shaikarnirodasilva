{
  "name": "trendsupply",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=shared",
    "build:backend": "npm run build --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=backend"
  }
}
